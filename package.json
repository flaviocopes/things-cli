{
  "name": "@flaviocopes/things-cli",
  "version": "0.1.0",
  "description": "Command line tool for the Things 3 app on macOS",
  "type": "module",
  "files": [
    "bin",
    "lib",
    ".agents/skills/things"
  ],
  "bin": {
    "things": "bin/things.js"
  },
  "os": [
    "darwin"
  ],
  "keywords": [
    "things",
    "things3",
    "cli",
    "macos",
    "productivity"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flaviocopes/things-cli.git"
  },
  "bugs": {
    "url": "https://github.com/flaviocopes/things-cli/issues"
  },
  "homepage": "https://github.com/flaviocopes/things-cli#readme",
  "scripts": {
    "check": "node --check bin/things.js && node --check lib/*.js && node --test",
    "prepublishOnly": "npm run check",
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
